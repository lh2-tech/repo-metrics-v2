# Copy this to .env: `cp .env.example .env`
#
# For public repos and local paths, .env can stay exactly as-is below — no
# token needed. Only fill in a token if you need to clone a PRIVATE repo on
# that platform; leave the others blank.

# GitHub — PAT with repo (read) access
GH_TOKEN=

# GitLab — access token with read_repository scope
GITLAB_TOKEN=

# Bitbucket — repository access token (or account-scoped token)
BITBUCKET_TOKEN=

# Where remote clones are cached inside the container. Leave as-is.
DATALABS_CLONES_DIR=/app/clones
